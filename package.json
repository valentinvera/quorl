{
  "name": "quorl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "browser:install": "playwright install chromium",
    "browser:open": "playwright cli open",
    "browser:serve-artifacts": "bun scripts/playwright/serve-artifacts.ts",
    "browser:show": "playwright cli show",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run db:generate --filter=@quorl/db",
    "db:migrate": "turbo run db:migrate --filter=@quorl/db",
    "db:migrate:deploy": "turbo run db:migrate:deploy --filter=@quorl/db",
    "db:push": "turbo run db:push --filter=@quorl/db",
    "db:studio": "turbo run db:studio --filter=@quorl/db",
    "dev": "turbo run dev --filter='./apps/*'",
    "dev:api": "turbo run dev --filter=@quorl/api --",
    "dev:desktop": "turbo run dev --filter=@quorl/desktop --",
    "dev:mobile": "turbo run dev --filter=@quorl/mobile --",
    "dev:web": "turbo run dev --filter=@quorl/web --",
    "fix": "ultracite fix",
    "start": "turbo run start --filter='./apps/*'",
    "test:e2e": "bun scripts/playwright/run.ts test",
    "test:e2e:headed": "bun scripts/playwright/run.ts test --headed",
    "test:e2e:ui": "bun scripts/playwright/run.ts test --ui"
  },
  "dependencies": {
    "@quorl/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "latest",
    "@playwright/test": "^1.61.1",
    "@quorl/ts-config": "workspace:*",
    "@types/bun": "catalog:",
    "glob": "^13.0.0",
    "lefthook": "latest",
    "sitemap": "^9.0.0",
    "tsdown": "^0.22.14",
    "turbo": "^2.10.7",
    "typescript": "catalog:",
    "ultracite": "7.9.4"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6",
      "@types/bun": "^1.3.14",
      "libsql": "0.5.29",
      "hono": "^4.12.32",
      "@trpc/server": "^11.18.0",
      "better-auth": "1.7.1",
      "@tanstack/react-query": "^5.101.4",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.3",
      "@trpc/tanstack-react-query": "^11.18.0",
      "@trpc/client": "^11.18.0",
      "@tanstack/react-form": "^1.33.2",
      "@types/react-dom": "^19.2.3",
      "tailwind-merge": "^3.6.0",
      "@better-auth/expo": "1.7.1"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "engines": {
    "bun": ">=1.3.50"
  },
  "packageManager": "bun@1.4.0"
}
